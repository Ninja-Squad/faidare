{
  "name": "faidaire-web",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "engines": {
    "node": "24.22.3"
  },
  "packageManager": "pnpm@12.22.0",
  "scripts": {
    "build": "tsc --noEmit && vite build --mode development",
    "build:prod": "tsc --noEmit && vite build",
    "watch": "concurrently --kill-others 'tsc --noEmit --watch' 'vite build --mode development --watch'",
    "watch:prod": "concurrently --kill-others 'tsc --noEmit --watch' 'vite build --watch'",
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "format:backend-templates": "cd .. && web/node_modules/.bin/oxfmt --write backend/src/main/resources/templates",
    "e2e": "playwright test --ui",
    "e2e:headless": "playwright test",
    "start:e2e": "cd .. && java -jar backend/build/libs/faidare.jar --spring.profiles.active=e2e",
    "start:e2e:ci": "cd .. && java -jar backend/build/libs/faidare.jar --spring.profiles.active=e2e,ci",
    "e2e:standalone": "start-server-and-test 'pnpm start:e2e' http-get://localhost:8381/faidare-dev 'pnpm e2e:headless'",
    "e2e:standalone:ci": "start-server-and-test 'pnpm start:e2e:ci' http-get://localhost:8381/faidare-dev 'pnpm e2e:headless'",
    "postinstall": "playwright install"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/leaflet": "1.9.22",
    "bootstrap": "5.3.9",
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/bootstrap": "5.2.11",
    "@types/leaflet.markercluster": "1.5.6",
    "autoprefixer": "10.7.0",
    "baseline-browser-mapping": "2.11.39",
    "concurrently": "10.0.7",
    "leaflet.markercluster": "1.5.3",
    "oxfmt": "0.79.0",
    "postcss": "8.5.33",
    "sass": "1.108.2",
    "start-server-and-test": "3.0.13",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  },
  "browserslist": [
    "defaults"
  ]
}
