{
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    "schedule:weekly",
    "security:minimumReleaseAgeNpm"
  ],
  // target chore/next branch
  "baseBranches": [
    "chore/next"
  ],
  // only 1 PR at the same time (to avoid cascading rebase)
  "prConcurrentLimit": 1,
  // auto-merge if build is OK
  "automerge": true,
  "packageRules": [
    // Skip the known bad postcss 8.5.26 release; allow newer versions in case they include a fix for https://github.com/cssnano/cssnano/issues/1846
    {
      "packageNames": [
          "postcss"
      ],
      "allowedVersions": "!/^8\\.5\\.26$/"
    },
    // allow only patch and minor updates for elasticsearch docker image
    {
      "packageNames": [
          "docker.elastic.co/elasticsearch/elasticsearch"
      ],
      "updateTypes": [
          "major"
      ],
      "enabled": false
    },
    // allow only patch and minor updates for elasticsearch dependencies
    {
      "packageNames": [
          "org.elasticsearch:elasticsearch",
          "org.elasticsearch.client:elasticsearch-rest-high-level-client"
      ],
      "updateTypes": [
          "major"
      ],
      "enabled": false
    },
    // allow only patch and minor updates for kibana docker image
    {
      "packageNames": [
          "docker.elastic.co/kibana/kibana"
      ],
      "updateTypes": [
          "major"
      ],
      "enabled": false
    }
  ]
}
